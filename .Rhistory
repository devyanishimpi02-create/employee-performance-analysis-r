read_csv("WA_Fn-UseC_-HR-Employee-Attrition.csv")
install.packages("tidyverse")
library(tidyverse)
data <- read_csv("WA_Fn-UseC_-HR-Employee-Attrition.csv")
head(data)
dim(data)
data$Department <- as.factor(data$Department)
data$JobRole <- as.factor(data$JobRole)
data$OverTime <- as.factor(data$OverTime)
data$BusinessTravel <- as.factor(data$BusinessTravel)
data$Gender <- as.factor(data$Gender)
data$MaritalStatus <- as.factor(data$MaritalStatus)
str(data)
colSums(is.na(data))
sum(duplicated(data))
department_analysis <- data %>%
group_by(Department) %>%
summarise(
Employees = n(),
Average_Performance = mean(PerformanceRating),
Average_Income = mean(MonthlyIncome),
Average_Job_Satisfaction = mean(JobSatisfaction)
)
department_analysis
write_csv(department_analysis, "department_analysis.csv")
ggplot(
department_analysis,
aes(x = Department, y = Average_Performance)
) +
geom_col() +
labs(
title = "Average Performance by Department",
x = "Department",
y = "Average Performance"
) +
theme_minimal()
department_analysis
jobrole_analysis <- data %>%
group_by(JobRole) %>%
summarise(
Employees = n(),
Average_Performance = mean(PerformanceRating),
Average_Income = mean(MonthlyIncome),
Average_Job_Satisfaction = mean(JobSatisfaction)
)
jobrole_analysis
write_csv(jobrole_analysis, "jobrole_analysis.csv")
ggplot(
jobrole_analysis,
aes(
x = reorder(JobRole, Average_Performance),
y = Average_Performance
)
) +
geom_col() +
coord_flip() +
labs(
title = "Average Performance by Job Role",
x = "Job Role",
y = "Average Performance"
) +
theme_minimal()
training_analysis <- data %>%
group_by(TrainingTimesLastYear) %>%
summarise(
Employees = n(),
Average_Performance = mean(PerformanceRating)
)
write_csv(
training_analysis,
"training_analysis.csv"
)
satisfaction_analysis <- data %>%
group_by(JobSatisfaction) %>%
summarise(
Employees = n(),
Average_Performance = mean(PerformanceRating)
)
write_csv(
satisfaction_analysis,
"satisfaction_analysis.csv"
)
overtime_analysis <- data %>%
group_by(OverTime) %>%
summarise(
Employees = n(),
Average_Performance = mean(PerformanceRating),
Average_Income = mean(MonthlyIncome)
)
write_csv(
overtime_analysis,
"overtime_analysis.csv"
)
experience_analysis <- data %>%
group_by(YearsAtCompany) %>%
summarise(
Employees = n(),
Average_Performance = mean(PerformanceRating)
)
write_csv(
experience_analysis,
"experience_analysis.csv"
)
income_analysis <- data %>%
group_by(JobLevel) %>%
summarise(
Employees = n(),
Average_Income = mean(MonthlyIncome),
Average_Performance = mean(PerformanceRating)
)
write_csv(
income_analysis,
"income_analysis.csv"
)
ggplot(
department_analysis,
aes(
x = Department,
y = Average_Performance
)
) +
geom_col() +
labs(
title = "Average Performance by Department",
x = "Department",
y = "Average Performance"
) +
theme_minimal()
ggplot(
jobrole_analysis,
aes(
x = reorder(JobRole, Average_Performance),
y = Average_Performance
)
) +
geom_col() +
coord_flip() +
labs(
title = "Average Performance by Job Role",
x = "Job Role",
y = "Average Performance"
) +
theme_minimal()
ggplot(
training_analysis,
aes(
x = TrainingTimesLastYear,
y = Average_Performance
)
) +
geom_line() +
geom_point() +
labs(
title = "Training vs Performance",
x = "Training Times Last Year",
y = "Average Performance"
) +
theme_minimal()
ggplot(
overtime_analysis,
aes(
x = OverTime,
y = Average_Performance
)
) +
geom_col() +
labs(
title = "Overtime vs Performance",
x = "Overtime",
y = "Average Performance"
) +
theme_minimal()
ggplot(
satisfaction_analysis,
aes(
x = JobSatisfaction,
y = Average_Performance
)
) +
geom_col() +
labs(
title = "Job Satisfaction vs Performance",
x = "Job Satisfaction",
y = "Average Performance"
) +
theme_minimal()
numeric_data <- data %>%
select(
Age,
MonthlyIncome,
JobLevel,
TrainingTimesLastYear,
JobSatisfaction,
YearsAtCompany,
YearsInCurrentRole,
YearsSinceLastPromotion,
PerformanceRating
)
correlation_matrix <- cor(numeric_data)
correlation_matrix
